# Required for live local news/advisories and webpage extraction
TINYFISH_API_KEY=

# Optional AI quotation selection: Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Cloudflare Worker proxy for Open-Meteo. Leave blank for direct API requests.
OPEN_METEO_PROXY_URL=
OPEN_METEO_PROXY_TOKEN=

# Optional
PORT=8787

# Per-process scan protection
MAX_CONCURRENT_SCANS=3
SCAN_RATE_LIMIT=6
SCAN_RATE_WINDOW_MS=600000
# Set only for a known, fixed reverse-proxy topology. Direct local servers use 0.
TRUST_PROXY_HOPS=0

# Trip workspace database. Use a mounted persistent disk in production.
TRACERISK_DB_PATH=data/tracerisk.sqlite
# Scheduled in-app Trip Watch checks (no email or push service).
TRIP_WATCH_ENABLED=true
# Optional routing/reverse-geocoding providers compatible with OSRM/Nominatim.
ROUTING_BASE_URL=https://router.project-osrm.org
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org
# Optional Photon-compatible landmark search (no key needed for the default).
PLACE_SEARCH_URL=https://photon.komoot.io
# Public browser tile configuration; do not put secret tokens in VITE variables.
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# VITE_MAP_ATTRIBUTION=Your provider attribution
