# Required for live local news/advisories and webpage extraction
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Primary AI assessment provider: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Secondary provider if Gemini fails: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Optional secondary Groq model; leave blank unless you intentionally configure one.
GROQ_FALLBACK_MODEL=

# Optional Cloudflare Worker proxy for Open-Meteo. Leave blank for direct API requests.
OPEN_METEO_PROXY_URL=
OPEN_METEO_PROXY_TOKEN=

# Optional
PORT=8787

# Per-process scan protection
MAX_CONCURRENT_SCANS=3
SCAN_RATE_LIMIT=6
SCAN_RATE_WINDOW_MS=600000
# Set only for a known, fixed reverse-proxy topology. Direct local servers use 0.
TRUST_PROXY_HOPS=0
