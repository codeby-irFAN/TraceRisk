{
  "name": "tracerisk-domestic-travel-dashboard",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:watch\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "format": "prettier --write .github e2e playwright.config.js server src tests vite.config.js package.json index.html render.yaml .prettierrc.json",
    "format:check": "prettier --check .github e2e playwright.config.js server src tests vite.config.js package.json index.html render.yaml .prettierrc.json",
    "server:watch": "node --watch server/index.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
